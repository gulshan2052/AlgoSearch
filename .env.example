# SQLite database URL
SQLITE_URL=sqlite:///./data/problems.db
# Directory where ChromaDB persists its data
CHROMA_PERSIST_DIR=./data/chroma
# Directory to drop scraped problem DBs for the import endpoint
IMPORT_SOURCE_DIR=./data/imports

# Logging
LOG_LEVEL=INFO

# Provider selection: "ollama" | "openai" | "gemini"
LLM_BACKEND=ollama
EMBEDDING_BACKEND=ollama

# Ollama config
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=qwen2.5-coder
OLLAMA_EMBED_MODEL=nomic-embed-text

# Gemini config
GEMINI_API_KEY=
GEMINI_LLM_MODEL=gemini-2.5-flash

# OpenAI / Claude (OpenAI-compatible) config
OPENAI_API_KEY=sk-...
# Optional: point at an OpenAI-compatible gateway (vLLM, LM Studio, proxy)
OPENAI_BASE_URL=
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small
